let nivel = " "
let saldo  

function rankeada(vitoria, derrota){
    saldo = vitoria - derrota
    return saldo
}

function definirNivel(){
    if (saldo <= 10){
    nivel = "Ferro"
    }   else if (saldo <= 20){
    nivel = "Bronze"
    }   else if (saldo <= 50){
    nivel = "Prata"
    }   else if (saldo <= 80){
    nivel = "Ouro"
    }   else if (saldo <= 90){
    nivel = "Diamante"
    }   else if (saldo <= 100){
    nivel = "Lendario"
    }   else {
    nivel = "Imortal"
    }
}

rankeada(100,6) // calcula o saldo de derrotas e vitorias
definirNivel() // so depois do calculo define o nivel
console.log(`O heroi tem o saldo de ${saldo} vitorias e está no nivel ${nivel}`)